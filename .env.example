# Copy this file to .env at the project root and fill in your values.
# Never commit the real .env to version control.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=temporal_rag

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# Required for answer generation. Retrieval works without it.
GROQ_API_KEY=gsk_...
# Groq retires hosted models periodically. If answer generation fails with a
# model error, run `python scripts/list_llm_models.py` from backend/ to see
# what your key can reach.
LLM_MODEL=openai/gpt-oss-120b

# ── Embeddings ───────────────────────────────────────────────────────────────
# "auto" uses CUDA when available and falls back to CPU.
# Set "cpu" or "cuda" to pin the device.
EMBEDDING_DEVICE=auto

# ── Search-index directory ───────────────────────────────────────────────────
# Where the FAISS and BM25 files live. Leave unset to use <project>/data.
# evaluation/README.md sets it (with DB_NAME) to keep its corpus separate.
# DATA_DIR=

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Set true to log every SQL statement (very verbose).
DB_ECHO=false
