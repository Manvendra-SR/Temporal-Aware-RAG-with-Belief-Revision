# Copy this file to .env at the project root and fill in your values.
# Never commit the real .env to version control.

# PostgreSQL connection
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=temporal_rag

# LLM — Groq (Phase 3+)
GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile

# App settings
APP_ENV=development
LOG_LEVEL=INFO
